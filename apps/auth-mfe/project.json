{
  "name": "auth-mfe",
  "root": true,
  "sourceRoot": "src",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "@nrwl/web:dev-server",
      "options": {
        "ssl": true
      }
    },
    "build": {
      "executor": "@nrwl/web:build",
      "outputs": [
        "{workspaceRoot}/dist/apps/auth-mfe"
      ],
      "options": {}
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "tsConfig": [
          "tsconfig.app.json",
          "tsconfig.spec.json"
        ],
        "exclude": [
          "**/node_modules/**",
          "!apps/auth-mfe/**/*"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "jest.config.ts",
        "tsConfig": [
          "tsconfig.app.json",
          "tsconfig.spec.json"
        ],
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}